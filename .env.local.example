# ============================================================
# ARONA MOBILES — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
#
# FOR VERCEL DEPLOYMENT:
# Add MSG91_AUTH_KEY and MSG91_WIDGET_ID in:
# Vercel Project → Settings → Environment Variables
# ============================================================

# ── MSG91 Official OTP Widget / API (Server-Side Only) ─────
# Get Auth Key from: https://control.msg91.com/
# Get Widget ID from: MSG91 Dashboard → OTP Widget (https://docs.msg91.com/otp-widget)
# NEVER prefix with NEXT_PUBLIC_ (Must remain server-side only)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_WIDGET_ID=your_msg91_widget_id_here

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Razorpay ─────────────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) for development
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Session Security ─────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-strong-random-secret-min-32-chars

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Next.js ──────────────────────────────────────────────────
# Set to 'production' in your hosting platform (Vercel sets this automatically)
NODE_ENV=development
